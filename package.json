{
  "name": "orb",
  "version": "0.1.0",
  "private": true,
  "description": "Orb — viral short-form video studio. Reddit stories, fake texts, split-screen, and more, rendered to MP4.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run bundle:video && next build",
    "start": "next start",
    "bundle:video": "remotion bundle src/remotion/index.ts --out-dir=.remotion-bundle",
    "studio": "remotion studio src/remotion/index.ts",
    "setup:voices": "node scripts/setup-voices.mjs",
    "generate:audio": "node scripts/generate-audio.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@remotion/bundler": "^4.0.535",
    "@remotion/media-utils": "^4.0.535",
    "@remotion/player": "^4.0.535",
    "@remotion/renderer": "^4.0.535",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.535",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.535",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
