# All keys are optional. Orb works fully offline with the bundled Kokoro voices.

# Premium voices with word-level timestamps
ELEVENLABS_API_KEY=
# OpenAI voices (tts) and Whisper transcription for Auto Captions / Split-Screen
OPENAI_API_KEY=
# Claude powers Script Writer, Idea Generator and the "Write with AI" buttons
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Local engines
KOKORO_MODEL=models/kokoro-v1.0.onnx
KOKORO_VOICES=models/voices-v1.0.bin
PYTHON_BIN=python3
# faster-whisper model used for local transcription (tiny, base, small, medium)
WHISPER_MODEL=base

# Rendering
# Point at an existing headless Chrome to skip Remotion's download
REMOTION_BROWSER_EXECUTABLE=
RENDER_CONCURRENCY=
STORAGE_DIR=storage
